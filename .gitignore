.superpowers/
# No trailing slash: a trailing slash only matches real directories, so a
# worktree that shares one checkout's dependencies through a `node_modules`
# symlink gets its link committed as a 120000 entry pointing at an absolute
# local path. The slashless form matches the link too.
node_modules
dist/
dist-electron/
npm/autovpn-cli/*.tgz
build/
!electron/build/
!electron/build/assets/
!electron/build/assets/app-icon-1024.png
!electron/build/assets/app-icon.ico
!electron/build/assets/app-icon.icns
electron/runtime/bundled-profile.toml
electron/runtime/share-worker/
electron/runtime/python-vendor/
electron/runtime/node-vendor/
electron/runtime/playwright-browsers/
.idea

